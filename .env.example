# Optional. Offline preview is the default; no keys are needed.
WORKSHOP_PORT=5790
WORKSHOP_N8N_PORT=5798
# PYTHON_BIN=C:/path/to/venv/Scripts/python.exe
# N8N_ENTRY=C:/path/to/node_modules/n8n/bin/n8n
# Live AI is enabled only with: node scripts/start.mjs --live-ai
ANTHROPIC_API_KEY=
# Live email is enabled only with: node scripts/start.mjs --live-email
# Start with an inbox you own. Preview addresses ending in .example cannot receive email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO_ALLOWLIST=
# Gmail API, enabled explicitly with --live-gmail and/or --gmail-inbox.
# See docs/CONNECTIONS.md.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Short-lived alternative to refresh credentials (expires; never paste into chat):
GMAIL_ACCESS_TOKEN=
GMAIL_FROM=
GMAIL_TO_ALLOWLIST=
GMAIL_INBOUND_ALLOWLIST=
GMAIL_LABEL=WorkshopDemo
# HubSpot contact upsert via n8n, enabled explicitly with --live-crm.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_EMAIL_ALLOWLIST=
